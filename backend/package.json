{
  "name": "mahalladosh-backend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "description": "Mahalladosh backend (Express 5 + PostgreSQL)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/index.ts",
    "db:migrate": "tsx src/cli/index.ts db:migrate",
    "db:seed:demo": "tsx src/cli/index.ts db:seed:demo",
    "contract:build": "tsx scripts/build-contract.ts",
    "contract:mock": "pnpm dlx @stoplight/prism-cli@5.16.0 mock -p 4010 -h 0.0.0.0 openapi.yaml",
    "bench": "tsx scripts/bench.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@electric-sql/pglite": "^0.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/functions": "3.11.3",
    "argon2": "^0.45.0",
    "busboy": "^1.6.0",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.0",
    "swagger-ui-dist": "^5.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/compression": "^1.7.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
