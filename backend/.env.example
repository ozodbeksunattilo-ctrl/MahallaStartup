NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Veb admin origin'lari (CSRF Origin tekshiruvi), vergul bilan
WEB_ORIGINS=http://localhost:3001
# Swagger UI (/api/docs) va /api/openapi.json: standart yoqiq; yopish uchun false
API_DOCS=true
# Faqat lokal: `round:close --now` kabi vaqt sayohati CLI'lari
ALLOW_TIME_TRAVEL=false

# =====================================================================================
# HECH NARSA O'RNATISH SHART EMAS: quyidagilar bo'sh bo'lsa lokal rejim ishlaydi
#   DATABASE_URL  bo'sh  -> ichki Postgres (PGlite), fayl: ./data/pglite
#   REDIS_URL     bo'sh  -> xotiradagi kesh / rate limit (bitta jarayon uchun)
#   S3_ENDPOINT   bo'sh  -> lokal fayl saqlash: ./data/media (HMAC imzoli vaqtinchalik URL)
# Production / jamoa uchun haqiqiy servislarni yozing (Docker, Neon, Upstash, R2, MinIO...).
# =====================================================================================

# PostgreSQL 16. `memory://` — testlar uchun xotirada.
# DATABASE_URL=postgresql://mahalladosh:mahalladosh@localhost:5432/mahalladosh
# Bulut (Neon):  postgresql://USER:PASS@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=20

# Redis (rate limit, sessiya keshi, Socket.IO adapter)
# REDIS_URL=redis://localhost:6379
# Bulut (Upstash, TLS):  rediss://default:PASS@xxxx.upstash.io:6379

# S3-compatible private bucket
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=mahalladosh-media
# S3_ACCESS_KEY=mahalladosh
# S3_SECRET_KEY=mahalladosh-secret
# S3_FORCE_PATH_STYLE=true
# Cloudflare R2:  S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=false

# Lokal saqlash uchun imzo kaliti (production'da S3 ishlatilsa kerak emas)
STORAGE_SIGNING_SECRET=dev-only-change-me
# Media fayl URL'lari uchun tashqi manzil. Bo'sh bo'lsa so'rov host'i ishlatiladi (lokal, emulyator, LAN).
# Production (proksi ortida): mobil ilova ulanadigan manzil, masalan https://<admin-panel-domen>
# PUBLIC_API_URL=https://example.com

# Push: bo'sh bo'lsa push yuborilmaydi (ichki bildirishnomalar baribir ishlaydi)
EXPO_ACCESS_TOKEN=
