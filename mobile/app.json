{
  "expo": {
    "name": "Mahalladosh",
    "slug": "mahalladosh",
    "scheme": "mahalladosh",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.mahalladosh.app"
    },
    "android": {
      "package": "uz.mahalladosh.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f4ea",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#f7f4ea"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Muammoga rasm biriktirish uchun galereyaga ruxsat kerak",
          "cameraPermission": "Muammoni suratga olish uchun kameraga ruxsat kerak"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#253a2d"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00c7dd54-6115-4ad0-ab05-483e4c199a64"
      }
    }
  }
}