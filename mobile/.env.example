# Android emulyatorda localhost avtomatik 10.0.2.2 ga almashtiriladi (src/lib/config.ts).
# Real qurilma: http://<kompyuter-LAN-IP>:3000  (backend HOST=0.0.0.0 bilan ishlasin)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Faqat dizaynni login (backend)siz ko`rish uchun true; odatda false.
EXPO_PUBLIC_SKIP_AUTH=false
# Backend ishlamasa ham ilovani ko`rish: barcha javoblar demo ma`lumotdan (src/lib/mock.ts)
EXPO_PUBLIC_DEMO=false
EXPO_PUBLIC_DEBUG=false
